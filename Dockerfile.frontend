# ==================== FRONTEND ====================
# Stage 1: builder - compiles the Vue app into static HTML/CSS/JS.
FROM node:lts AS builder

# Set the builder working directory
WORKDIR /app

# Copy frontend project (/webui) in working directory (/app)
COPY ./webui .

# Builds the app
RUN npm run build-prod

# Stage 2: runtime - nginx serves the static files.
FROM nginx:stable

# Copy the generated files into nginx's web root
COPY --from=builder /app/dist /usr/share/nginx/html

# No CMD needed: the nginx image already defines its own.

# ==================== Usage ====================
# docker build -t wasa-frontend . -f Dockerfile.frontend
# docker run -it --rm -p 8080:80 wasa-frontend
